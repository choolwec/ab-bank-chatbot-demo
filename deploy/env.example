# AB Bank Zambia chatbot: production environment (ticket P7).
# Install: install -m 600 -o root -g root deploy/env.example /etc/abz-chatbot/env
# then fill it in. Real values NEVER go in git; they live only in that file
# (and its backup). Every variable the app reads is listed here, blank.
#
# Rules:
# - Lines under "Required" must have a value: deploy.sh refuses to restart
#   the service otherwise.
# - Leave an optional line commented out unless you set it. "KEY=" with
#   nothing after it is NOT the same as unset: a blank number crashes the
#   app, so deploy.sh refuses any blank line.
# - No quotes and no spaces around "=" (systemd EnvironmentFile syntax).

# --- Required -----------------------------------------------------------------

# Where databases, logs and generated keys live. Production: /var/lib/abz-chatbot/data
ABZ_DATA_DIR=
# Kill switches, editable without a restart. Production: /etc/abz-chatbot/flags.json
ABZ_FLAGS_FILE=
# The embedding model (deploy.sh fetches it). Production: /opt/abz-chatbot/models/all-MiniLM-L6-v2
EMBED_MODEL_DIR=
# Reverse proxies in front of the app: 1 with nginx alone, 2 if a bank load balancer or WAF is also in front.
PROXY_HOPS=
# The website(s) that embed the widget, comma-separated. [CONFIRM: e.g. https://www.abbank.co.zm]
ALLOWED_ORIGINS=
# HMAC secret for user_hash. Generate: openssl rand -hex 32. Changing it breaks per-customer continuity in reports.
USER_KEY_SECRET=
# Fernet key(s) for sealed reply addresses, comma-separated, primary first. Generate: deploy/admin.sh rotate_reply_key --generate
REPLY_KEY=

# --- Staff pages (/admin/*, 404 while either is unset) ------------------------

# ADMIN_USER=
# Long and random; rotate per docs/runbook-production.md.
# ADMIN_PASSWORD=

# --- WhatsApp Cloud API (mock mode while the token is unset) ------------------

# System User token from Meta Business Settings.
# WA_ACCESS_TOKEN=
# WA_PHONE_NUMBER_ID=
# App secret: signs every webhook (X-Hub-Signature-256).
# WA_APP_SECRET=
# Any long random string, also entered in the Meta app's webhook settings.
# WA_VERIFY_TOKEN=
# Graph API version; default v23.0. [VERIFY: the current version before launch]
# WA_GRAPH_VERSION=
# Leave unset (https://graph.facebook.com); tests and the load script point it elsewhere.
# GRAPH_BASE_URL=

# --- Facebook Messenger (mock mode while the token is unset) ------------------

# MS_PAGE_TOKEN=
# MS_PAGE_ID=
# MS_APP_SECRET=
# MS_VERIFY_TOKEN=
# MS_APP_ID=

# --- Jira handoff (mock mode until all four are set) --------------------------

# JIRA_BASE_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=
# Issue-key prefix used only in mock mode; default CC.
# JIRA_MOCK_PROJECT_KEY=

# --- Agent desk and handoff (H2) ------------------------------------------------

# Chatwoot base URL; setting it makes WhatsApp handoff default to "inbox". Other CHATWOOT_* arrive with H2.
# CHATWOOT_URL=
# "callback" or "inbox" per channel; defaults: web and WhatsApp callback, Messenger inbox.
# HANDOFF_MODE_WEB=
# HANDOFF_MODE_WHATSAPP=
# HANDOFF_MODE_MESSENGER=

# --- Alerts (R1) ----------------------------------------------------------------

# Where python -m admin.alerts posts (email relay or Teams). [CONFIRM: destination, PO]
# ALERT_WEBHOOK_URL=

# --- Kill switches ---------------------------------------------------------------
# Keep these in flags.json, not here: a value here overrides flags.json and
# needs a restart to change, which defeats a kill switch.

# FREE_TEXT_ENABLED=
# WIDGET_ENABLED=
# WHATSAPP_ENABLED=
# MESSENGER_ENABLED=
# MESSENGER_PUBLIC_REPLIES=
# JIRA_ENABLED=
# EMBEDDINGS_ENABLED=
# SHADOW_MATCHER=
# URGENT_MODEL_ENABLED=

# --- Matcher thresholds (set by calibration; leave unset) -----------------------

# EMB_HIGH=
# EMB_MEDIUM=
# EMB_URGENT=

# --- Sessions, retention and limits (defaults in app/config.py) ------------------

# Minutes idle before the widget greets again; default 30.
# IDLE_REGREET_MINUTES=
# Hours before an unfinished flow is dropped; default 24.
# FLOW_EXPIRY_HOURS=
# The same for fraud and complaint reports; default 72.
# FLOW_EXPIRY_HOURS_URGENT=
# A webhook message older than this is not used to resume a flow; default 10.
# STALE_MESSAGE_MINUTES=
# Days transcripts and sessions are kept; default 90. [CONFIRM: Legal]
# TRANSCRIPT_RETENTION_DAYS=
# Days tickets are kept; 0 = never purged (default). [CONFIRM: complaints unit policy]
# TICKET_RETENTION_DAYS=
# Messages per minute per IP on /chat; default 20.
# RATE_LIMIT_PER_MINUTE=
# Messages per minute per customer on the webhooks; default 20.
# USER_RATE_LIMIT_PER_MINUTE=
# "memory" is for tests only; leave unset (SQLite).
# SESSION_STORE=

# --- Contact details and hours shown to customers (defaults in app/config.py) ----

# [CONFIRM: a 24-hour card-blocking line, if one exists]
# ABZ_EMERGENCY_PHONE=
# ABZ_CONTACT_PHONE=
# ABZ_CONTACT_EMAIL=
# ABZ_WEBSITE_URL=
# ABZ_TARIFF_URL=
# Contact Centre closed days, ISO dates, comma-separated. [CONFIRM: the bank's holiday list]
# PUBLIC_HOLIDAYS=
